---
import site from '../data/site.json';
import { semOrfas } from '../scripts/tipografia.js';
const { hero, tagline } = site;
---
<section class="hero">
  <div class="envolve hero__int">
    <div class="hero__texto">
      <p class="hero__etiqueta">{tagline}</p>
      <h1>{hero.titulo}</h1>
      <p class="hero__lead">{semOrfas(hero.texto)}</p>
      <div class="hero__accoes">
        <a class="botao" href="#quadro">Ver o prato de hoje</a>
        <a class="botao botao--vazio" href="#visita">Como chegar</a>
      </div>
    </div>
    <figure class="hero__fig">
      <img src={hero.imagem} alt={hero.legendaImagem} width="840" height="640" />
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--feltro-esc);
    color: var(--giz);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero__int {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero__int { grid-template-columns: 1.05fr .95fr; }
  }
  .hero__etiqueta {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--latao);
    margin: 0 0 1.25rem;
  }
  .hero h1 {
    font-size: clamp(var(--t-xl), 7vw, var(--t-3xl));
    margin-bottom: 1.5rem;
  }
  .hero__lead {
    font-size: var(--t-md);
    line-height: 1.5;
    color: rgba(237,233,220,.8);
    max-width: 38ch;
  }
  .hero__accoes {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .hero__fig { margin: 0; }
  .hero__fig img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 16;
    object-fit: cover;
    border-radius: 2px;
    background: var(--feltro-claro);
  }
</style>
