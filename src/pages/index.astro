---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Quadro from '../components/Quadro.astro';
import Almoco from '../components/Almoco.astro';
import Noite from '../components/Noite.astro';
import Carta from '../components/Carta.astro';
import Historia from '../components/Historia.astro';
import Visita from '../components/Visita.astro';
import Rodape from '../components/Rodape.astro';
---
<Base>
  <Nav />
  <main id="conteudo">
    <Hero />
    <Quadro />
    <Almoco />
    <Noite />
    <Carta />
    <Historia />
    <Visita />
  </main>
  <Rodape />
</Base>
